SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 2 * * * root /opt/fdeclub/shared/backup.sh >> /var/log/fdeclub-maintenance.log 2>&1
30 2 * * * root /usr/bin/node /opt/fdeclub/shared/maintenance.mjs retention >> /var/log/fdeclub-maintenance.log 2>&1
*/5 * * * * root /usr/bin/node /opt/fdeclub/shared/maintenance.mjs >> /var/log/fdeclub-maintenance.log 2>&1
